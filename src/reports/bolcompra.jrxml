	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="vCodcompra" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select a.*,b.*,p.*,c.nombre as razon,c.direccion as direccion, c.telefono as telefono,c.ruc as ruc,d.usuario as usuario,b.total as totald, p.nomprodu from compra a inner join detcompra b on a.codcompra = b.compra_codcompra
     inner join proveedor c on a.proveedor_codprov = c.codprov
     inner join usuario d on a.usuario_id=d.id
     inner join producto p on b.producto_codprodu = p.codprodu
     where a.codcompra = $P{vCodcompra}]]>
	</queryString>
	<field name="nomprodu" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="preunit" class="java.lang.Integer"/>
	<field name="fecha" class="java.util.Date"/>
	<field name="totald" class="java.lang.Integer"/>
	<field name="razon" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="ruc" class="java.lang.String"/>
	<field name="codcompra" class="java.lang.Integer"/>
	<field name="usuario" class="java.lang.String"/>
	<variable name="totalf" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{totald}]]></variableExpression>
	</variable>
