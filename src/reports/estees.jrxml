<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" language="groovy" pageWidth="390" pageHeight="150" columnWidth="390" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="7ed2d2d3-9f9a-47b2-90ef-4c01ef87f9eb">
	<property name="ireport.zoom" value="2.1435888100000016"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="vCodventa" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     a.*,
     b.*,
     p.*,
     b."por_ven" AS producto,
     b."cantidad" AS cantidad,
     b."preunit" AS precio,
     c."razon" AS razon,
     concat(c."nombre",' ',c."apellido") AS direccion,
     c."telefono" AS telefono,
     c."ruc" AS ruc,
     d."usuario" AS vendedor,
     b."total" AS sub_total,
     b."ivacinco" AS cinco,
     b."ivadiez" AS diez,
     b."ivaex" AS exentas,
     a."descripcion" AS descrip
FROM
     "venta" a INNER JOIN "detventa" b ON a."codventa" = b."venta_codventa"
     INNER JOIN "cliente" c ON a."cliente_id" = c."id"
     INNER JOIN "usuario" d ON a."usuario_id" = d."id"
     INNER JOIN "producto" p ON b."producto_codprodu" = p."codprodu"
     INNER JOIN "marca" k ON p."marca" = k."id_marca"
WHERE
     a.codventa = $P{vCodventa}]]>
	</queryString>
	<field name="codventa" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="ruc" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
