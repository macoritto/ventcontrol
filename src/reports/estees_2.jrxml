	<queryString>
		<![CDATA[SELECT
     a.*,
     b.*,
     p.*,
     b."por_ven" AS producto,
     b."cantidad" AS cantidad,
     b."preunit" AS precio,
     c."razon" AS razon,
     concat(c."nombre",' ',c."apellido") AS direccion,
     c."telefono" AS telefono,
     c."ruc" AS ruc,
     d."usuario" AS vendedor,
     b."total" AS sub_total,
     b."ivacinco" AS cinco,
     b."ivadiez" AS diez,
     b."ivaex" AS exentas,
     a."descripcion" AS descrip
FROM
     "venta" a INNER JOIN "detventa" b ON a."codventa" = b."venta_codventa"
     INNER JOIN "cliente" c ON a."cliente_id" = c."id"
     INNER JOIN "usuario" d ON a."usuario_id" = d."id"
     INNER JOIN "producto" p ON b."producto_codprodu" = p."codprodu"
     INNER JOIN "marca" k ON p."marca" = k."id_marca"
WHERE
     a.codventa = $P{vCodventab}]]>
	</queryString>
