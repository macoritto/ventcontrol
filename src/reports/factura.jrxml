	<parameter name="vCodventa" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     a.*,
     b.*,
     p.*,
     p."nomprodu" AS nomproducto,
     b."id_inv" idinv,	
     d."usuario" AS usu,
     a."descripcion" AS descrip
FROM
     "inventario" a INNER JOIN "detinv" b ON a."id_inv" = b."inventario"
     INNER JOIN "usuario" d ON a."usuario" = d."id"
     INNER JOIN "producto" p ON b."producto" = p."codprodu"
WHERE
     a.id_inv = $P{vCodventa}]]>
	</queryString>
