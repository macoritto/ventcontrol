	<parameter name="vCodventa" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.*,b.*,p.*,c.razon as razon,concat(c."nombre",' ',"apellido") as direccion, c.telefono as telefono,c.ruc as ruc,d.usuario as vendedor,b.total as totald, b.por_ven as nomproducto, a.descripcion as descrip from presupuesto a inner join detpresu b on a.codpresu = b.presupuesto_codpresu
     inner join cliente c on a.cliente_id = c.id
     inner join usuario d on a.usuario_id=d.id
     inner join producto p on b.producto_codprodu = p.codprodu
     inner join marca k on p.marca=k.id_marca
     where codpresu = $P{vCodventa}]]>
	</queryString>
