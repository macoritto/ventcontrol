	<queryString>
		<![CDATA[SELECT
     codprodu,
     nomprodu,
     tipo_id,
     costo,
     venta,
     stock,
     c.nombre as descrip,
m.nombre as marcas
FROM producto
     INNER JOIN tipo c ON tipo_id = c.id INNER JOIN marca m ON marca=m.id_marca ORDER BY codprodu]]>
	</queryString>
