	<property name="ireport.zoom" value="2.3579476910000046"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="144"/>
	<parameter name="vfecha" class="java.util.Date">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="cant" class="java.lang.Integer"/>
	<parameter name="vfecha1" class="java.util.Date">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="cod" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT c.nomprodu as nomprodu, c.codprodu as codigo, c.unidad_medida as medida, c.stock as stock, t.nombre as tipoprodu, v.fecha as fecha, det.cantidad as cantidad, det.preunit as preunit, det.total as total FROM detventa det
INNER JOIN producto c on det.producto_codprodu= c.codprodu
INNER JOIN tipo t on c.tipo_id= t.id
INNER JOIN venta v on det.venta_codventa=v.codventa
where det.producto_codprodu=$P{cod} and v.fecha BETWEEN $P{vfecha} and $P{vfecha1} AND v.cliente_id=$P{cod} ORDER BY det.id]]>
	</queryString>
	<field name="codigo" class="java.lang.Integer"/>
	<field name="total" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="nomprodu" class="java.lang.String"/>
	<field name="tipoprodu" class="java.lang.String"/>
	<field name="medida" class="java.lang.String"/>
	<field name="stock" class="java.lang.Integer"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="preunit" class="java.lang.String"/>
	<variable name="suma" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
