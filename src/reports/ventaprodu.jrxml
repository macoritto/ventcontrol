	<parameter name="vfecha" class="java.util.Date">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="cant" class="java.lang.Integer"/>
	<parameter name="vfecha1" class="java.util.Date">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="cod" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT v.codventa, c.nombre as nombre, c.apellido as apellido, v.descripcion, v.total, v.fecha, c.id codigo, c.ruc as ruc, c.telefono as telefono, c.direccion as direccion FROM venta v
INNER JOIN cliente c on v.cliente_id= c.id where v.fecha BETWEEN $P{vfecha} and $P{vfecha1} and v.cliente_id=$P{cod} ORDER BY v.codventa]]>
	</queryString>
	<field name="codventa" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="apellido" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="total" class="java.lang.Integer"/>
