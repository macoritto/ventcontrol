	<parameter name="vfecha" class="java.util.Date">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="cant" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT v.codventa, c.nombre as nombre, c.apellido as apellido, v.descripcion, v.total, v.fecha FROM venta v
INNER JOIN cliente c on v.cliente_id= c.id where v.fecha=$P{vfecha} ORDER BY v.codventa]]>
	</queryString>
	<field name="codventa" class="java.lang.Integer"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="apellido" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="total" class="java.lang.Integer"/>
	<field name="fecha" class="java.sql.Date"/>
	<variable name="chofer" class="java.lang.String">
		<variableExpression><![CDATA[($F{nombre}!=null?$F{nombre}:"")+($F{apellido}!=null?","+$F{apellido}:"")]]></variableExpression>
	</variable>
	<variable name="suma" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
